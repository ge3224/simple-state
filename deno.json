{
  "tasks": {
    "dev": "VITE_ROOT=examples deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "test": "deno test src/",
    "test:watch": "deno test --watch src/",
    "test:coverage": "deno test --coverage src/",
    "bench": "deno bench benchmark/",
    "typecheck": "deno check src/**/*.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "vite": "npm:vite@^7.1.9",
    "vite-plugin-dts": "npm:vite-plugin-dts@^4.5.4"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true
  },
  "exclude": [
    "dist/**",
    "node_modules/**"
  ],
  "nodeModulesDir": "auto"
}
